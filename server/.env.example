# Copy to .env and adjust per site. All values optional; defaults shown.
PORT=3000

# Weakest acceptable signals (dBm). Readings below these are denied.
RSSI_FLOOR_DBM=-70
WIFI_FLOOR_DBM=-60

# GPS boundary. Enforced only when the site coordinates are set.
GPS_MAX_METERS=50
#SITE_LATITUDE=
#SITE_LONGITUDE=

# Postgres connection; migrations via `npm run db:migrate`. Required for
# enrollment, signed validation, and audit logging.
#DATABASE_URL=postgres://user:pass@localhost:5432/proxies

# Gates the /admin endpoints (user + device creation). Unset disables them.
#ADMIN_TOKEN=

# Dev-only: accept unsigned validation bodies when no database is configured.
# Never enable outside a desk demo.
#ALLOW_UNSIGNED_VALIDATION=true

# Max signed-timestamp age (ms) accepted on nonce requests.
#TIMESTAMP_TOLERANCE_MS=300000

# Validity window (ms) of an issued single-use validation nonce.
#NONCE_TTL_MS=120000

# Rate limits (per client IP). Enroll endpoints get the stricter budget.
#RATE_LIMIT_WINDOW_MS=900000
#RATE_LIMIT_MAX=300
#RATE_LIMIT_ENROLL_MAX=10

# Set true only behind a reverse proxy so limits see real client addresses.
#TRUST_PROXY=true

# Serve HTTPS directly (dev: mkcert). In production, a terminating reverse
# proxy + TRUST_PROXY is equally fine.
#TLS_CERT_PATH=./certs/server.pem
#TLS_KEY_PATH=./certs/server-key.pem
