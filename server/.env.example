# Copy to .env and adjust per site. All values optional; defaults shown.
PORT=3000

# Weakest acceptable signals (dBm). Readings below these are denied.
RSSI_FLOOR_DBM=-70
WIFI_FLOOR_DBM=-60

# GPS boundary. Enforced only when the site coordinates are set.
GPS_MAX_METERS=50
#SITE_LATITUDE=
#SITE_LONGITUDE=

# Postgres connection; migrations via `npm run db:migrate`. Required for
# enrollment, signed validation, and audit logging.
#DATABASE_URL=postgres://user:pass@localhost:5432/proxies

# Gates the /admin endpoints (user + device creation). Unset disables them.
#ADMIN_TOKEN=

# Dev-only: accept unsigned validation bodies when no database is configured.
# Never enable outside a desk demo.
#ALLOW_UNSIGNED_VALIDATION=true

# Interim replay guard until nonces (P1.3): max signed-timestamp age in ms.
#TIMESTAMP_TOLERANCE_MS=300000
