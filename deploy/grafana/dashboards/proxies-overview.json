{
  "uid": "proxies-overview",
  "title": "Proxies Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Telemetry by metric",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "proxies-pg" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "spanNulls": true } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS \"time\", value, type AS metric FROM telemetry WHERE $__timeFilter(ts) AND type <> 'presence' ORDER BY ts"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Presence events (window)",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "postgres", "uid": "proxies-pg" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS presence FROM telemetry WHERE type = 'presence' AND $__timeFilter(ts)"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Recent alerts",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "postgres", "uid": "proxies-pg" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT a.created_at, r.metric_type, r.op, r.threshold, a.value, a.delivered FROM alerts a JOIN rules r ON r.id = a.rule_id ORDER BY a.created_at DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Fleet last seen",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "postgres", "uid": "proxies-pg" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(name, id::text) AS device, kind, status, last_seen_at FROM devices ORDER BY last_seen_at ASC NULLS FIRST LIMIT 50"
        }
      ]
    }
  ]
}
